# Painel administrativo (obrigatório)
ADMIN_USER=seu-usuario-aqui
ADMIN_PASS=sua-senha-forte-aqui

# PostgreSQL/Neon para armazenar produtos e pedidos em produção
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Token criado ao conectar um Blob público ao projeto Vercel
BLOB_READ_WRITE_TOKEN=seu-token-vercel-blob

# WhatsApp da loja no formato 55DDDNUMERO
WHATSAPP_NUMBER=5561999999999
